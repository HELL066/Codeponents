{
  "name": "codeponents",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:registry": "node scripts/prepare-registry.mjs",
    "registry:build": "npm run prepare:registry && shadcn build registry.json --output public/r/v1",
    "predev": "npm run registry:build",
    "dev": "vite",
    "prebuild": "npm run registry:build",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/unna": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tailwindcss/vite": "^4",
    "agents": "^0.33.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.18.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "skullet": "^0.0.3",
    "sonner": "^2.0.8",
